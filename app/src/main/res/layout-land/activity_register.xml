<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="قرّب وجهك من الكاميرا..."
            android:textAlignment="center"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اسم الموظف"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvBootstrapNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ أول تسجيل - سيُسجَّل كمسؤول رئيسي تلقائيًا"
            android:textAlignment="center"
            android:textColor="#B26A00"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/radioGroupRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radioUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="موظف عادي"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مسؤول" />

            <RadioButton
                android:id="@+id/radioSuperAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مسؤول رئيسي" />

        </RadioGroup>

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ الموظف"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>
